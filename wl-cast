#!/usr/bin/env bash
# wl-cast — start and stop the browser stream of this screen.
#
#   wl-cast start [OPTION...]   start it and print its links
#   wl-cast stop
#   wl-cast status              the links, if it runs
#   wl-cast dim [on|off]        with start -d: turn the screen black, or
#                               light it again (no argument: the other)
#
# Options:
#   -o OUTPUT    the screen to stream (default: asked when there are
#                several, in the terminal or by a click with slurp)
#   -a ADDRESS   the address put in the links (default: the local
#                network's, on the default route)
#   -p PORT      HTTP port (8081); -t PORT: HTTPS port (8443)
#   -k KEY       the key the link carries; -k '' for none.  Default: a random
#                one, kept between runs so that a bookmark keeps working
#   -r FPS       frame rate (30)
#   -s SCREEN    phone (the screen as it is), client (a screen of the
#                viewer's size) or multi-monitor (a second screen)
#   -A APPROVE   off, tap (a notification) or fingerprint, for a new viewer
#   -v WHO       hotspot, lan (default) or wan: who may connect
#   -w on|off    keep the screen awake while streaming (default on):
#                through your hook if it does it, else swayidle paused
#   -d           dim instead of blank: a screen turned off is not
#                captured, so while the stream runs, `wl-cast dim' turns
#                it black and back instead.  Bind your blanking key (the
#                power key) to `wl-cast dim || <your blank command>': it
#                then toggles dim while wl-cast streams this screen, and
#                blanks as usual otherwise.  The brightness is back when
#                the stream ends (brightnessctl)
#   -T           with -d: the screen's own touch input off while dimmed
#                (a phone in a pocket); the viewer's still works
#   -h           this help
#
# wl-cast-server does the work; this only picks its arguments.
# wf-recorder is the fallback when wl-cast-capture cannot run.  The
# page's own buttons and the host's hook are in ~/.config/wl-cast
# (README).
set -u

rt=${XDG_RUNTIME_DIR:-/tmp}
state=${XDG_STATE_HOME:-$HOME/.local/state}/wl-cast
pid_file=$rt/wl-cast.pid
links_file=$rt/wl-cast.links
dimmed=$rt/wl-cast.dimmed               # the brightness to go back to
dim_ok=$rt/wl-cast.dim                  # start -d: "dim", or "dim touch" (-T)
touch_off=$rt/wl-cast.touch-off         # the touch devices turned off
key_file=$state/key

running() { [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; }

usage() { awk 'NR > 2 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "$0"; }

stop() {
    running && kill -TERM -- "-$(cat "$pid_file")" 2>/dev/null
    rm -f "$pid_file" "$links_file"
    dim off
    rm -f "$dim_ok"
    # swayidle paused by a server that did not end cleanly.
    [ -f "$rt/wl-cast-idle-stopped" ] && xargs kill -CONT < "$rt/wl-cast-idle-stopped" 2>/dev/null
    rm -f "$rt/wl-cast-idle-stopped"
}

# Dimmed, not blanked: a screen turned off is not captured.  Not when the
# stream shows a screen of its own (wl-cast-screen): that one goes on.
dim() {
    case "${1:-}" in
        off)
            [ -f "$dimmed" ] || return 0
            brightnessctl -q set "$(cat "$dimmed")"
            rm -f "$dimmed"
            [ -f "$touch_off" ] && while read -r d; do
                swaymsg "input \"$d\" events enabled" >/dev/null
            done < "$touch_off"
            rm -f "$touch_off" ;;
        on)
            running && [ -f "$dim_ok" ] && [ ! -s "$rt/wl-cast-output" ] || return 1
            [ -f "$dimmed" ] && return 0
            brightnessctl -m | cut -d, -f3 > "$dimmed" && brightnessctl -q set 0
            if grep -q touch "$dim_ok"; then
                swaymsg -t get_inputs -r | jq -r '.[] | select(.type == "touch")
                    | select(.identifier | test("wl-cast-remote") | not) | .identifier' > "$touch_off"
                while read -r d; do
                    swaymsg "input \"$d\" events disabled" >/dev/null
                done < "$touch_off"
            fi ;;
        *)
            if [ -f "$dimmed" ]; then dim off; else dim on; fi ;;
    esac
}

# The output to stream: -o, WL_CAST_PANEL, the only one, or the one picked.
pick_output() {
    [ -n "${WL_CAST_PANEL:-}" ] && { echo "$WL_CAST_PANEL"; return; }
    outs=$(swaymsg -t get_outputs -r | jq -r '.[] | select(.active) | .name')
    if [ "$(printf '%s\n' "$outs" | grep -c .)" -le 1 ]; then
        echo "$outs"
    elif [ -t 0 ] && command -v fzf >/dev/null; then
        printf '%s\n' "$outs" | fzf --prompt='screen to stream > ' --height=~10
    elif [ -t 0 ]; then
        select o in $outs; do [ -n "$o" ] && { echo "$o"; break; }; done
    elif command -v slurp >/dev/null; then
        slurp -o -f %o
    else
        printf '%s\n' "$outs" | head -1
    fi
}

# The one on the default route (the local network's, not a VPN's), else
# any but USB, loopback, containers, bridges and VPNs: only the host, or
# its VPN's peers, reach those.
address() {
    ip -4 route get 1.1.1.1 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "src") { print $(i + 1); exit } }' |
        grep . ||
        ip -4 -o addr show scope global |
        awk '$2 !~ /^(usb|lo|waydroid|veth|docker|br-|tailscale|wg|tun)/ { sub("/.*", "", $4); print $4; exit }'
}

start() {
    addr= port=8081 tls=8443 fps=30 screen=phone approve=off who=lan dims=
    key=$(cat "$key_file" 2>/dev/null)
    if [ -z "$key" ]; then
        mkdir -p "$state"
        key=$(LC_ALL=C tr -dc 'a-km-z2-9' < /dev/urandom 2>/dev/null | head -c 5)
        echo "$key" > "$key_file"
    fi
    while getopts o:a:p:t:k:r:s:A:v:w:dTh o; do
        case $o in
            o) WL_CAST_PANEL=$OPTARG ;; a) addr=$OPTARG ;; p) port=$OPTARG ;; t) tls=$OPTARG ;;
            k) key=$OPTARG ;; r) fps=$OPTARG ;; s) screen=$OPTARG ;;
            A) approve=$OPTARG ;; v) who=$OPTARG ;;
            w) [ "$OPTARG" = off ] && export WL_CAST_AWAKE=0 ;;
            d) dims="dim${dims#dim}" ;; T) dims="${dims:-dim} touch" ;; h) usage; exit ;;
            *) usage >&2; exit 2 ;;
        esac
    done
    WL_CAST_PANEL=$(pick_output)
    [ -n "$WL_CAST_PANEL" ] || { echo "wl-cast: no screen chosen" >&2; exit 1; }
    export WL_CAST_PANEL
    addr=${addr:-$(address)}
    [ -n "$addr" ] || { echo "wl-cast: no network" >&2; exit 1; }

    # The output's size in pixels, even, its long side at most 1920 or the
    # size last chosen on the page.
    long=$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/wl-cast-size" 2>/dev/null)
    read -r turn w h < <(swaymsg -t get_outputs -r | jq -r --arg o "$WL_CAST_PANEL" '
        [.[] | select(.name == $o)][0]
        | "\(.transform) \(.rect.width * .scale) \(.rect.height * .scale)"')
    read -r w h < <(awk -v w="$w" -v h="$h" -v l="${long:-1920}" 'BEGIN {
        m = w > h ? w : h; f = m > l ? l / m : 1
        w = int(w * f + 0.5); h = int(h * f + 0.5); print w - w % 2, h - h % 2 }')
    # wf-recorder scales before it turns the picture.
    case "$turn" in *90|*270) filter="scale=$h:$w" ;; *) filter="scale=$w:$h" ;; esac

    stop
    setsid wl-cast-server --raw "${w}x$h@$fps" ${key:+--key "$key"} --tls "$tls" \
        --screen "$screen" --approve "$approve" --visibility "$who" \
        --portal "$turn" --interactive "$port" \
        wf-recorder -D -r "$fps" -F "$filter" -m rawvideo -c rawvideo -x nv12 -f pipe:1 -- \
        wf-recorder -D -r "$fps" -m ivf -c libvpx -x yuv420p -p deadline=realtime \
            -p cpu-used=8 -p threads=4 -p b=4000000 -p g="$fps" -f pipe:1 \
        >/dev/null 2>&1 </dev/null &
    echo $! > "$pid_file"
    sleep 1
    running || { rm -f "$pid_file"; echo "wl-cast: the server did not start" >&2; exit 1; }
    printf 'http://%s:%s/%s\nhttps://%s:%s/%s\n' "$addr" "$port" "${key:+?k=$key}" \
           "$addr" "$tls" "${key:+?k=$key}" | tee "$links_file"
    case "$dims" in dim*) echo "$dims" > "$dim_ok" ;; esac
    return 0
}

case "${1:-}" in
    start) shift; start "$@" ;;
    stop) stop ;;
    status) running && cat "$links_file" ;;
    dim) dim "${2:-}" ;;
    -h|--help|help) usage ;;
    *) usage >&2; exit 2 ;;
esac
