#!/usr/bin/env bash
# When the car connects over Bluetooth, start the hotspot and the stream.
#
# The car joins the phone's hotspot and opens the link in its browser.  The
# stream stops when the car leaves; the hotspot stays up.  Set device to the
# name `bluetoothctl devices' shows, and hotspot to the NetworkManager
# connection of your hotspot.  Run it at login, e.g. from your Sway config:
#   exec ~/.local/bin/car-bluetooth

device="My car"
hotspot=Hotspot
address=10.42.0.1               # NetworkManager's address on a hotspot

mac_of() {
    bluetoothctl devices | while read -r _ mac name; do
        [ "$name" = "$device" ] && echo "$mac"
    done
}
connected() { bluetoothctl info "$1" 2>/dev/null | grep -q 'Connected: yes'; }
hotspot_on() { [ "$(nmcli -g GENERAL.STATE connection show "$hotspot" 2>/dev/null)" = activated ]; }

start() {
    echo "$(date +%T) $device connected"
    hotspot_on || nmcli connection up "$hotspot"
    for _ in $(seq 30); do
        [ -n "$(ip -4 -o addr show to "$address")" ] && break
        sleep 1
    done
    wl-cast start -a "$address" -v hotspot || echo "$(date +%T) stream did not start"
}

stop() {
    echo "$(date +%T) $device disconnected"
    wl-cast stop
}

trap '[ -n "$on" ] && stop; exit' TERM
on=
while sleep 5; do
    mac=${mac:-$(mac_of)}
    [ -n "$mac" ] || continue
    if connected "$mac"; then
        [ -n "$on" ] || { start; on=1; }
    elif [ -n "$on" ]; then
        stop
        on=
    fi
done
