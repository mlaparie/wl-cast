#!/bin/sh
# wl-cast-cert — an HTTPS name for the stream on the phone's hotspot,
# as root: `wl-cast start' runs it through sudo when the settings name a
# domain and the hotspot is up; run it by hand after the settings change.
# Prints the result.
#
#   sudo wl-cast-cert           the calling user's settings
#   wl-cast-cert SETTINGS       as root, another file
#
# Some browsers refuse plain HTTP, self-signed certificates and local
# addresses, and resolve names through their own DNS: a Tesla's (found
# 2026-11-19), likely other car infotainment systems.  For them, as
# tesla-carplay does: a domain of the user's whose public A record is an
# address in no private range (240.3.3.4 by default), a Let's Encrypt
# certificate for it (certbot, DNS challenge through the DNS provider's
# API; renewed when 30 days are left, else a second's check), and the
# phone's hotspot sending that address, ports 443 and 8443, to the
# stream's HTTPS port 8443 (nftables, until the next reboot: hence every
# start).  So https://NAME/ works in the car, with no port.  Only on the
# phone's own hotspot: on another network nothing sends that address to
# the phone.  Offline, the certificate already there is kept and the
# redirect still set: the car needs no internet on the phone.
#
# The settings are the user's (~/.config/wl-cast/https.conf, mode 600;
# a link or another owner's file is refused):
#   STREAM_DOMAIN=stream.example.com   the name; empty or absent: nothing
#   STREAM_ADDRESS=240.3.3.4           its A record
#   DNS_PROVIDER=porkbun               wl-cast-dns-PROVIDER: its API
#                                      (porkbun; cloudflare, desec not yet run)
#   PORKBUN_API_KEY=…  PORKBUN_SECRET_KEY=…   the provider's keys, PROVIDER_…
# It is read as KEY=value lines, never run: names in capitals, values of
# plain characters only.
#
#   /var/lib/wl-cast/tls/cert.pem, key.pem   the certificate (key: group users),
#                                                 which wl-cast-server serves
#   /var/lib/wl-cast/tls/name                its name, for wl-cast's links
#   /var/lib/wl-cast/tls/status              the last result
#   /var/lib/wl-cast/letsencrypt                    certbot's account and certificates
#   /var/log/wl-cast-cert.log                every result
#
# Needs certbot, nft, curl and openssl in PATH (a distribution wraps them
# in: sudo gives a bare environment).
#
# State: the same steps worked from a Tesla on the phone's hotspot with
# Porkbun as the Pro¹x port's pro1x-stream-cert (2026-11-19); this
# script's redirect form and offline path are tested on the PC only
# (2026-11-27).

PATH=/run/current-system/profile/bin:/run/current-system/profile/sbin:$PATH
# Shepherd gives a bare environment: curl and certbot need the CA store.
export SSL_CERT_DIR=/etc/ssl/certs
export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
if [ -n "${SUDO_USER:-}" ]; then
    # /etc/passwd itself: getent is not in the system's profile.
    home=$(awk -F: -v u="$SUDO_USER" '$1 == u { print $6 }' /etc/passwd)
    settings=$home/.config/wl-cast/https.conf
    if [ -L "$settings" ] ||
           { [ -e "$settings" ] && [ "$(stat -c %U "$settings")" != "$SUDO_USER" ]; }; then
        echo "$settings: not the user's own file" >&2
        exit 1
    fi
else
    settings=${1:?usage: sudo wl-cast-cert, or as root: wl-cast-cert SETTINGS}
fi
dir=/var/lib/wl-cast/tls
le=/var/lib/wl-cast/letsencrypt

say() {
    mkdir -p "$dir"
    echo "$*" > "$dir/status"
    echo "$(date '+%F %T') $*" >> /var/log/wl-cast-cert.log
    echo "$*"
}

# The last KEY=value line for KEY, quotes removed; nothing if the value has
# other characters than plain ones.
setting() {
    v=$(sed -n "s/^[[:space:]]*$1=//p" "$settings" 2>/dev/null | tail -1 |
            tr -d '\r' | sed -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' \
                             -e "s/^'\(.*\)'$/\1/")
    case "$v" in *[!A-Za-z0-9_.:@/+=-]*) return 1 ;; esac
    echo "$v"
}

# The hotspot's packets for ADDRESS port 443 (and 8443) to the stream's
# 8443 on this host.  `redirect' sends them to the address of the
# interface they came in on, whichever the hotspot has (NetworkManager
# gives 10.42.0.1 to its first shared connection, 10.42.1.1 to a second);
# a fixed `dnat to 10.42.0.1' did not.  The hotspot runs on wlan0, or on
# ap0 beside a Wi-Fi network (the Pro¹x's Keep Wi-Fi).
redirect() {
    nft delete table ip wl_cast 2>/dev/null || true
    [ -n "$1" ] || return 0
    printf '%s\n' \
        'table ip wl_cast {' \
        '    chain prerouting {' \
        '        type nat hook prerouting priority dstnat - 1;' \
        "        iifname { \"wlan0\", \"ap0\" } ip daddr $1 tcp dport { 443, 8443 } redirect to :8443" \
        '    }' \
        '}' | nft -f - || { say "$domain: nft could not set the redirect"; return 1; }
}

# No name: no redirect, and the stream back to the phone's own certificate.
unset_name() {
    redirect ""
    rm -f "$dir/cert.pem" "$dir/key.pem" "$dir/name"
    say "not set"
}

install_cert() {                # install_cert CERT KEY NAME
    cp "$1" "$dir/cert.new" && cp "$2" "$dir/key.new" || return 1
    chgrp users "$dir/key.new" && chmod 640 "$dir/key.new"
    chmod 644 "$dir/cert.new"
    mv "$dir/cert.new" "$dir/cert.pem"
    mv "$dir/key.new" "$dir/key.pem"
    echo "$3" > "$dir/name"
}

once() {
    domain=$(setting STREAM_DOMAIN) || { say "STREAM_DOMAIN: unexpected characters"; return; }
    [ -n "$domain" ] || { unset_name; return; }
    case "$domain" in
        *[!a-z0-9.-]*|*.*.*.*.*.*|.*|*.) say "STREAM_DOMAIN: not a name: $domain"; return ;;
        *.*) ;;
        *) say "STREAM_DOMAIN: not a name: $domain"; return ;;
    esac
    address=$(setting STREAM_ADDRESS) || address=
    : "${address:=240.3.3.4}"
    case "$address" in
        *[!0-9.]*|*..*|.*|*.) say "STREAM_ADDRESS: not an address: $address"; return ;;
    esac
    provider=$(setting DNS_PROVIDER) || provider=
    [ -n "$provider" ] || { say "DNS_PROVIDER: not set (porkbun, cloudflare or desec)"; return; }
    case "$provider" in *[!a-z0-9]*) say "DNS_PROVIDER: unknown: $provider"; return ;; esac
    hook=wl-cast-dns-$provider
    command -v "$hook" >/dev/null || { say "DNS_PROVIDER: unknown: $provider"; return; }
    for tool in nft certbot curl openssl; do
        command -v "$tool" >/dev/null || { say "$tool: not found in PATH (needed as root)"; return; }
    done
    # The provider's keys, for its script: only its own variables
    # (PORKBUN_… for porkbun), never others (PATH, LD_PRELOAD…) of this
    # user-written file in a root environment.
    prefix=$(echo "$provider" | tr a-z A-Z)_
    for name in $(sed -n "s/^[[:space:]]*\\($prefix[A-Z0-9_]*\\)=.*/\\1/p" "$settings" | sort -u); do
        value=$(setting "$name") && export "$name=$value"
    done
    # A certificate from before, still good for a day: offline (no
    # internet on the phone, the car waiting), it is kept and the redirect
    # set all the same; the DNS record and the renewal wait for the next
    # start online.
    kept=
    [ -e "$le/live/$domain/fullchain.pem" ] &&
        openssl x509 -in "$le/live/$domain/fullchain.pem" -noout -checkend 86400 >/dev/null 2>&1 &&
        kept=1
    if ! "$hook" a "$domain" "$address" >> /var/log/wl-cast-cert.log 2>&1; then
        [ -n "$kept" ] || { say "$domain: the DNS record could not be set (keys, API access, internet?)"; return; }
        echo "$(date '+%F %T') $domain: the DNS record not checked (offline?); certificate kept" >> /var/log/wl-cast-cert.log
    fi
    if certbot certonly --non-interactive --agree-tos --register-unsafely-without-email \
            --config-dir "$le" --work-dir "$le/work" --logs-dir "$le/logs" \
            --manual --preferred-challenges dns --keep-until-expiring \
            --manual-auth-hook "$hook auth" --manual-cleanup-hook "$hook cleanup" \
            --cert-name "$domain" -d "$domain" >/dev/null 2>&1 || [ -n "$kept" ]
    then
        install_cert "$le/live/$domain/fullchain.pem" "$le/live/$domain/privkey.pem" "$domain" ||
            { say "$domain: the certificate could not be installed"; return; }
        until=$(openssl x509 -in "$dir/cert.pem" -noout -enddate 2>/dev/null | cut -d= -f2)
        redirect "$address" || return
        say "$domain, certificate until ${until:-?}"
    else
        say "$domain: no certificate (see $le/logs/letsencrypt.log)"
    fi
}

if [ -r "$settings" ]; then once; else unset_name; fi
